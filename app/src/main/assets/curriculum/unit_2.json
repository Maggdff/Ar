   "title": "أدوات العلاقات",
   "order": 5,
   "sourcePage": 34,
   "contentBlocks": [
    {
     "type": "note",
     "lines": [
      "هل x تساوي y: == (مثال x==y)",
      "هل x لا تساوي y: != (مثال x!=y)",
      "هل x أصغر من y: < (مثال x<y)",
      "هل x أكبر من y: > (مثال x>y)",
      "هل x أكبر أو يساوي y: >= (مثال x>=y)",
      "هل x أصغر أو يساوي y: <= (مثال x<=y)"
     ]
    }
   ],
