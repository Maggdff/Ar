   "title": "تمرين محلول على الأولويات",
   "order": 3,
   "sourcePage": 31,
   "contentBlocks": [
    {
     "type": "code",
     "lines": [
      "// افترض أن a=5, b=10, c=8",
      "x = --a + 3*b - c/a * b;",
      "// الحل:",
      "a = --a = 4",
      "t1 = 3*b = 30",
      "t2 = c/a = 8/4 = 2",
      "t3 = t2*b = 2*10 = 20",
      "t4 = a+t1 = 4+30 = 34",
      "t5 = t4-t3 = 34-20 = 14",
      "x = t5 = 14"
     ]
    }
   ],
